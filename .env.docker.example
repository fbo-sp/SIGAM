# Sobrescreva somente quando as portas padrão estiverem ocupadas.
SIGAM_APP_PORT=8080
SIGAM_DB_PORT=3307
SIGAM_MAILPIT_PORT=8025

# Credenciais exclusivamente locais. Não reutilize em outros ambientes.
SIGAM_DB_DATABASE=sigam
SIGAM_DB_USERNAME=sigam
SIGAM_DB_PASSWORD=sigam_local
SIGAM_DB_ROOT_PASSWORD=sigam_root_local

# Defina SIGAM_ADMIN_PASSWORD na sessão do PowerShell antes de subir o ambiente
# para que o seeder crie/atualize o administrador local.
SIGAM_ADMIN_NAME=Administrador
SIGAM_ADMIN_EMAIL=admin@sigam.local
SIGAM_ADMIN_PASSWORD=

